# Copy to .env and fill in real values before running docker compose.

# PostgreSQL password (also used in DATABASE_URL)
POSTGRES_PASSWORD=change-me

# JWT signing key — generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Initial admin account (created on first start only)
ADMIN_EMAIL=kouadiojose@gmail.com
ADMIN_PASSWORD=change-me

# Allowed CORS origins (comma-separated). Not needed when nginx proxies /api same-origin,
# but kept strict by default.
CORS_ORIGINS=https://yeoyedjande.com

# Public port of the web container
WEB_PORT=80
